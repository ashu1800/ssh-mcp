# 必填：服务器管理服务签发的 MCP 密钥（同时用于调用接口和派生解密密钥）
MCP_KEY=mcp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 凭据服务地址（默认即可）
# SSH_MCP_CREDENTIALS_URL=https://ssh.ashu180.cn/api/mcp/credentials
# SSH_MCP_CREDENTIALS_CACHE_TTL=45          # 秒；0 关闭缓存
# SSH_MCP_CREDENTIALS_TIMEOUT=15
# SSH_MCP_CREDENTIALS_MAX_RETRIES=3

# 本地状态目录（known_hosts / 私钥 / 认证状态）
# SSH_MCP_STATE_DIR=~/.ssh-mcp
# 单个状态文件的位置也可以分别覆盖（默认都在上面目录下）
# SSH_MCP_KNOWN_HOSTS=~/.ssh-mcp/known_hosts
# SSH_MCP_AUTH_STATE=~/.ssh-mcp/auth_state.json
# SSH_MCP_KEYS_DIR=~/.ssh-mcp/keys

# 允许 AI 读写的本机目录，多个用系统路径分隔符分开
# SSH_MCP_ALLOWED_LOCAL_ROOTS=~/ssh-mcp-files

# 推荐用它代替上一条：只限制下载落盘的目录，上传仍可读任意目录
# SSH_MCP_WRITE_LOCAL_ROOTS=~/ssh-mcp-files

# SSH 连接
# SSH_MCP_CONNECT_TIMEOUT=10
# SSH_MCP_LOGIN_TIMEOUT=20
# SSH_MCP_KEEPALIVE_INTERVAL=30
# SSH_MCP_KEEPALIVE_COUNT_MAX=3
# SSH_MCP_POOL_IDLE_TIMEOUT=300
# SSH_MCP_POOL_REAPER_INTERVAL=60
# SSH_MCP_POOL_MAX_ENTRIES=64                 # 同时保持的连接上限，超限时先淘汰最久未用的空闲连接
# SSH_MCP_POOL_HANDLE_TTL=3600                # 连接关闭后 handle 再保留多久；窗口内下次调用自动透明重连
# SSH_MCP_MAX_CONCURRENT_CONNECTS=4           # 同时进行的 SSH 握手上限，防止对卡住的主机堆积半开连接
# SSH_MCP_COMPRESSION=auto                  # auto(=on) | on | off；连接级协商，建立时决定

# 命令执行
# SSH_MCP_COMMAND_TIMEOUT_DEFAULT=30
# SSH_MCP_COMMAND_TIMEOUT_MAX=600
# SSH_MCP_COMMAND_MAX_OUTPUT_BYTES=262144   # stdout/stderr 各自上限，需低于 512 KiB 的结果文本预算

# SFTP
# SSH_MCP_SFTP_BLOCK_SIZE=262144
# SSH_MCP_SFTP_FALLBACK_BLOCK_SIZE=65536      # 对不接受大块的老服务器降级时用的块大小
# SSH_MCP_SFTP_MAX_REQUESTS=16
# SSH_MCP_SFTP_BUFFER_SIZE=1048576
# SSH_MCP_SFTP_IDLE_TIMEOUT=180             # 完全无进展多少秒才放弃；链路慢会自动放宽
# SSH_MCP_SFTP_TOTAL_TIMEOUT=0              # 0 = 不限制总时长
# SSH_MCP_SFTP_RETRY_ATTEMPTS=3             # 断线后自动续传的次数（0 = 关闭）
# SSH_MCP_SFTP_RETRY_DELAY=3                # 首次重试前的等待秒数，之后翻倍
# SSH_MCP_SFTP_CONCURRENCY=4
# SSH_MCP_DIRECTORY_ENTRY_LIMIT=500

# Streamable HTTP（对外暴露时必须设置 SSH_MCP_HTTP_TOKEN）
# SSH_MCP_HTTP_HOST=127.0.0.1
# SSH_MCP_HTTP_PORT=8765
# SSH_MCP_HTTP_TOKEN=change-me
# SSH_MCP_HTTP_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765

# SSH_MCP_LOG_LEVEL=INFO
# SSH_MCP_CONFIG=/path/to/config.toml
